FORGERY_PREDICTOR=heuristic
# FORGERY_PREDICTOR=torch   # or keras
# FORGERY_MODEL_PATH=models/cnn.keras
FORGERY_NUM_FRAMES=16
FORGERY_FRAME_SIZE=224
FORGERY_NORMALIZE_MODE=unit
FORGERY_DETECT_FACES=false
FORGERY_SAVE_FRAMES=false
FORGERY_MAX_UPLOAD_MB=50
FORGERY_DELETE_AFTER_PROCESSING=true

# --- database (optional; leave unset to use the in-memory store) ---
# Local SQLite file:   FORGERY_DATABASE_URL=sqlite:///data/forgery.db
# Docker/PostgreSQL:   set automatically by docker-compose.yml
# FORGERY_DATABASE_URL=sqlite:///data/forgery.db
# Used only by docker-compose.yml:
# POSTGRES_PASSWORD=choose_a_password
